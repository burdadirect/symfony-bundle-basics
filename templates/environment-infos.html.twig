{% set environment = app.environment|default('n/a') %}
{% if environment in ['stage', 'dev'] or is_granted(role|default('ROLE_ADMIN_SUPER')) %}
  <span class="ml-auto mr-5 text-600">
    <span class="ml-3">PHP: <strong>{{ constant('PHP_VERSION') }}</strong></span>
    <span class="ml-3">Umgebung: <strong>{{ environment }}</strong></span>
    <span class="ml-3">Datum: <strong>{{ 'now'|date('Y-m-d H:i:s') }}</strong></span>
  </span>
{% endif %}
